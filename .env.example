# Copy to .env for local development. Never commit .env.
ENV=development
PORT=8080
LOG_LEVEL=debug
LOG_FORMAT=console
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/contract-tracker
# Tracing is off until this is set (OTLP over HTTP, e.g. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=
# LLM through OpenRouter only (ADR-0001, ADR-0002). Put the real key in .env, never here.
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-4.5
LLM_BUDGET_STOP_USD=1.80
# Spend before this date does not count toward the stop (ADR-0014).
LLM_BUDGET_SINCE=2026-10-05
# Committed reply cache (ADR-0009); replays cost nothing and need no key.
LLM_CACHE_DIR=llm_cache
# Embeddings run locally on CPU (ADR-0004); make fetch-model saves the model into this folder.
EMBEDDING_MODEL_DIR=models
# Questions whose best clause scores under this cosine similarity are refused with no LLM call
# (ADR-0013); 0.70 was set from the golden-question spike (evals/qa/floor-spike.md).
QA_SIMILARITY_FLOOR=0.70
# Reminder email to MailHog (ADR-0010, Q-002).
SMTP_HOST=localhost
SMTP_PORT=1025
REMINDER_TO=owner@contracttracker.test
REMINDER_FROM=reminders@contracttracker.test
# Treat this date as today for reminders (YYYY-MM-DD); leave empty to use the real date. A date
# ahead of the real one is a preview: emails go to MailHog and nothing is recorded.
PRETEND_TODAY=
